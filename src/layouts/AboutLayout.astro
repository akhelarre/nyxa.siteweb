---
import BaseLayout from './BaseLayout.astro';
const { pageTitle } = Astro.props;

const identity = {
  alias: "N. Victoria Arenas",
  role: "Cineasta & Análisis de Sistemas",
  stack: ["HTML", "CSS", "JavaScript", "Astro", "WebGL", "Java"]
};
---

<BaseLayout pageTitle={pageTitle}>
  <section class="about-container">
    <header class="profile-spec">
      <div><strong>AVATAR:</strong> {identity.alias}</div>
      <div><strong>DISCIPLINA:</strong> {identity.role}</div>
      <div class="stack-row">
        {identity.stack.map((tech) => <span class="tech-badge">{tech}</span>)}
      </div>
    </header>

    <slot />
  </section>
</BaseLayout>

<style>
  .profile-spec {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    border: 1px solid var(--border-line);
    font-size: 0.85rem;
    color: var(--fg-muted);
  }

  .stack-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .tech-badge {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border-line);
    color: var(--accent);
  }
</style>