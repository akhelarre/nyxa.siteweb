---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    pubDate: string | Date;
    description?: string;
    author?: string;
    image?: {
      url: string;
      alt: string;
    };
    tags?: string[];
  };
}

const { frontmatter } = Astro.props;

const dateObj = new Date(frontmatter.pubDate);
const dateIso = !isNaN(dateObj.getTime())
  ? dateObj.toISOString().slice(0, 10)
  : String(frontmatter.pubDate);
---

<BaseLayout pageTitle={frontmatter.title}>
  <article class="post-article">
    <header class="post-header">
      <div class="post-meta-bar">
        <span>DATE // {dateIso}</span>
        {frontmatter.author && <span>AUTHOR // {frontmatter.author}</span>}
      </div>

      <h1>{frontmatter.title}</h1>

      {frontmatter.description && (
        <p class="post-lead">{frontmatter.description}</p>
      )}

      {frontmatter.tags && frontmatter.tags.length > 0 && (
        <div class="post-tags">
          {frontmatter.tags.map((tag: string) => (
            <a class="tag-badge" href={`/tags/${tag}`}>#{tag}</a>
          ))}
        </div>
      )}

      {frontmatter.image?.url && (
        <figure class="post-figure">
          <img
            src={frontmatter.image.url}
            alt={frontmatter.image.alt || frontmatter.title}
            loading="lazy"
          />
        </figure>
      )}
    </header>

    <div class="post-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    border-bottom: 1px solid var(--border-line);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .post-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.78rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .post-header h1 {
    margin-top: 0.25rem;
    margin-bottom: 0.75rem;
  }

  .post-lead {
    font-size: 1.05rem;
    color: var(--fg-muted);
    font-style: italic;
    margin: 0 0 1rem 0;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .tag-badge {
    font-size: 0.78rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border-line);
    background: rgba(255, 255, 255, 0.03);
    color: var(--fg-primary);
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .tag-badge:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .post-figure {
    margin: 1.25rem 0 0 0;
  }

  .post-figure img {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border: 1px solid var(--border-line);
    display: block;
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border-line);
    margin: 2.25rem 0;
  }

  .post-content :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.5rem 1rem;
    border-left: 2px solid var(--accent);
    background: rgba(255, 255, 255, 0.02);
  }
</style>