---
import BaseLayout from './BaseLayout.astro';

interface NavLink {
  url: string;
  title: string;
}

interface Props {
  frontmatter: {
    title: string;
    pubDate: string | Date;
    description?: string;
    author?: string;
    collection?: string;
    image?: {
      url: string;
      alt?: string;
    };
    tags?: string[];
  };
  entryNumber?: number;
  totalEntries?: number;
  prevPost?: NavLink | null;
  nextPost?: NavLink | null;
}

const { frontmatter, entryNumber, totalEntries, prevPost, nextPost } = Astro.props;

const collectionLabels: Record<string, string> = {
  cinema_studies: 'CINEMA_STUDIES',
  essays: 'ESSAYS',
  literature: 'LITERATURE'
};
const collectionLabel = frontmatter.collection
  ? (collectionLabels[frontmatter.collection] || frontmatter.collection.toUpperCase())
  : '';

const dateObj = new Date(frontmatter.pubDate);
const dateIso = !isNaN(dateObj.getTime())
  ? dateObj.toISOString().slice(0, 10)
  : String(frontmatter.pubDate);
---

<BaseLayout pageTitle={frontmatter.title}>
  <article class="post-article">
    <nav class="post-top-bar" aria-label="Retorno al archivo">
      <div class="top-nav-links">
        <a class="back-btn" href="/blog/">← [VOLVER A /ARCHIVE]</a>
        {frontmatter.collection && (
          <a class="back-btn" href={`/${frontmatter.collection}/`}>
            [/{collectionLabel}]
          </a>
        )}
      </div>
      <span class="node-counter">
        {entryNumber && totalEntries
          ? `ENTRY // ${String(entryNumber).padStart(2, '0')} OF ${String(totalEntries).padStart(2, '0')}`
          : 'NODE // ARCHIVE'}
      </span>
    </nav>

    <div class="reading-frame">
      <header class="post-header">
        <div class="post-meta-bar">
          <span>DATE // {dateIso}</span>
          {frontmatter.author && <span>AUTHOR // {frontmatter.author}</span>}
          {frontmatter.collection && (
            <a class="meta-collection-link" href={`/${frontmatter.collection}/`}>
              COLLECTION // [{collectionLabel}]
            </a>
          )}
        </div>

        <h1>{frontmatter.title}</h1>

        {frontmatter.description && (
          <p class="post-lead">{frontmatter.description}</p>
        )}

        {frontmatter.tags && frontmatter.tags.length > 0 && (
          <div class="post-tags">
            {frontmatter.tags.map((tag: string) => (
              <a class="tag-badge" href={`/tags/${tag}`}>#{tag}</a>
            ))}
          </div>
        )}

        {frontmatter.image?.url && (
          <figure class="post-figure">
            <img
              src={frontmatter.image.url}
              alt={frontmatter.image.alt || frontmatter.title}
              loading="lazy"
            />
          </figure>
        )}
      </header>

      <div class="post-content">
        <slot />
      </div>
    </div>

    <nav class="post-pager" aria-label="Navegación entre entradas">
      {prevPost ? (
        <a class="pager-cell pager-prev" href={prevPost.url}>
          <span class="pager-label">← [ENTRADA ANTERIOR]</span>
          <strong class="pager-title">{prevPost.title}</strong>
        </a>
      ) : (
        <div class="pager-cell pager-disabled">
          <span class="pager-label">[INICIO DEL ARCHIVO]</span>
          <span class="pager-muted">No hay entradas previas</span>
        </div>
      )}

      <a class="pager-cell pager-index" href="/blog/">
        <span class="pager-label">[ÍNDICE CENTRAL]</span>
        <strong class="pager-title">/ARCHIVE</strong>
      </a>

      {nextPost ? (
        <a class="pager-cell pager-next" href={nextPost.url}>
          <span class="pager-label">[SIGUIENTE ENTRADA] →</span>
          <strong class="pager-title">{nextPost.title}</strong>
        </a>
      ) : (
        <div class="pager-cell pager-disabled pager-next">
          <span class="pager-label">[FIN DEL ARCHIVO]</span>
          <span class="pager-muted">Última transmisión registrada</span>
        </div>
      )}
    </nav>
  </article>
</BaseLayout>

<style>
  .post-top-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.82rem;
  }

  .top-nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .back-btn {
    color: var(--fg-primary);
    text-decoration: none;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--border-line);
    background: var(--bg-reading);
    letter-spacing: 0.03em;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .back-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .node-counter {
    color: var(--accent);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border-line);
    background: var(--bg-reading);
  }

  /* Marco de lectura de alto contraste para descansar la vista del fondo WebGL */
  .reading-frame {
    background: var(--bg-reading);
    border: 1px solid var(--border-line);
    padding: clamp(1.5rem, 4vw, 3rem);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.35);
  }

  .post-header {
    border-bottom: 1px solid var(--border-line);
    padding-bottom: 1.75rem;
    margin-bottom: 2.25rem;
  }

  .post-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.8rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }

  .meta-collection-link {
    color: var(--fg-primary);
    text-decoration: none;
    border: 1px solid var(--border-line);
    padding: 0.15rem 0.55rem;
    background: rgba(255, 255, 255, 0.04);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .meta-collection-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .post-header h1 {
    margin-top: 0.35rem;
    margin-bottom: 1rem;
    line-height: 1.25;
  }

  .post-lead {
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--fg-muted);
    font-style: italic;
    margin: 0 0 1.25rem 0;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .tag-badge {
    font-size: 0.78rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--border-line);
    background: rgba(255, 255, 255, 0.04);
    color: var(--fg-primary);
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .tag-badge:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .post-figure {
    margin: 1.5rem 0 0 0;
  }

  .post-figure img {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border: 1px solid var(--border-line);
    display: block;
  }

  /* Espaciado respirable y cómodo para lectura prolongada */
  .post-content {
    line-height: 1.85;
    letter-spacing: 0.01em;
  }

  .post-content :global(p) {
    margin-top: 0;
    margin-bottom: 1.4rem;
    max-width: 70ch;
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1.25rem 0 1.5rem 0;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.65rem;
    line-height: 1.75;
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border-line);
    margin: 2.5rem 0;
  }

  .post-content :global(blockquote) {
    margin: 1.75rem 0;
    padding: 0.85rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: rgba(255, 255, 255, 0.03);
    line-height: 1.75;
  }

  /* Pager inferior (Anterior / Índice / Siguiente) con mayor aire y separación */
  .post-pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .pager-cell {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.55rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--border-line);
    background: var(--bg-reading);
    text-decoration: none;
    color: var(--fg-primary);
    transition: border-color 0.15s ease, transform 0.15s ease, color 0.15s ease;
  }

  a.pager-cell:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  a.pager-cell:hover .pager-title {
    color: var(--accent);
  }

  .pager-index {
    align-items: center;
    text-align: center;
    padding: 1.25rem 1.75rem;
  }

  .pager-next {
    align-items: flex-end;
    text-align: right;
  }

  .pager-disabled {
    opacity: 0.5;
    cursor: default;
  }

  .pager-label {
    font-size: 0.74rem;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pager-title {
    font-size: 0.95rem;
    color: var(--fg-primary);
    line-height: 1.45;
  }

  .pager-muted {
    font-size: 0.85rem;
    color: var(--fg-muted);
    line-height: 1.4;
  }

  @media (max-width: 720px) {
    .post-pager {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .pager-next,
    .pager-index {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
