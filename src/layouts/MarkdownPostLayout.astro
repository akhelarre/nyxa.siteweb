---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    pubDate: string | Date;
    description?: string;
    author?: string;
    image?: {
      url: string;
      alt: string;
    };
    tags?: string[];
  };
}

const { frontmatter } = Astro.props;

// Safe date string parsing
const dateObj = new Date(frontmatter.pubDate);
const dateIso = !isNaN(dateObj.getTime())
  ? dateObj.toISOString().slice(0, 10)
  : String(frontmatter.pubDate);
---

<BaseLayout pageTitle={frontmatter.title}>
  <p>Published on: {dateIso}</p>
  {frontmatter.author && <p>Written by {frontmatter.author}</p>}
  {frontmatter.description && <p><em>{frontmatter.description}</em></p>}

  {
    frontmatter.image && (
      <img
        src={frontmatter.image.url}
        alt={frontmatter.image.alt}
        width="300"
      />
    )
  }

  <div class="tags">
    {
      frontmatter.tags?.map((tag: string) => (
        <p class="tag">
          <a href={`/tags/${tag}`}>{tag}</a>
        </p>
      ))
    }
  </div>

  <slot />
</BaseLayout>

<style>
  a {
    color: #00539f;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px #a1a1a1;
    border-radius: 0.5em;
    padding: 0.5em 1em;
    font-size: 1.15em;
    background-color: #f8fcfd;
  }
</style>