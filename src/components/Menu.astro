<button aria-expanded="false" aria-controls="main-menu" class="menu-btn"> ☰
</button>

<style>
  .menu-btn {
    background-color: #0d0950;
    border: none;
    color: #fff;
    font-size: 2rem;
    font-weight: bold;
    padding: 9px 15px;
    cursor: pointer;
  }
  
