---
import ThemeIcon from './ThemeIcon.astro';
---

<header class="cell-header">
  <div class="brand-bar">
    <a href="/" class="sys-id">SYS.33 // DISEÑADORA VIRTUAL</a>
    <div class="header-controls">
      <ThemeIcon />
      <button type="button" class="menu-toggle" aria-expanded="false" aria-label="Alternar menú">
        [MENU]
      </button>
    </div>
  </div>

  <nav class="nav-matrix" id="nav-matrix">
    <a href="/">/INDEX</a>
    <a href="/blog/">/BLOG_ARCHIVE</a>
    <a href="/about/">/MANIFESTO</a>
    <a href="/wiki/">/ARS_ARKA</a>
    <a href="/tags/">/TAGS</a>
  </nav>
</header>

<script>
  const toggleBtn = document.querySelector('.menu-toggle');
  const navMatrix = document.getElementById('nav-matrix');

  toggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
    toggleBtn.textContent = !isExpanded ? '[CLOSE]' : '[MENU]';
    navMatrix?.classList.toggle('is-open');
  });

  document.addEventListener('click', (e) => {
    if (!navMatrix?.contains(e.target as Node)) {
      navMatrix?.classList.remove('is-open');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      if (toggleBtn) toggleBtn.textContent = '[MENU]';
    }
  });
</script>