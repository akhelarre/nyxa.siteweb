---
import Menu from './Menu.astro';
import Navigation from './Navigation.astro';
import ThemeIcon from './ThemeIcon.astro';
---

<header class="site-header">
  <div class="header-container">
    <nav class="nav-wrapper">
      <div class="top-row">
        <ThemeIcon />
        <!-- Menú desplegable exclusivo para móviles -->
        <div class="mobile-menu">
          <Menu>
            <Navigation />
          </Menu>
        </div>
      </div>
      <!-- Navegación normal exclusiva para PC -->
      <div class="desktop-navigation">
        <Navigation />
      </div>
    </nav>
  </div>
</header>
</header>

<style>
  .site-header {
    width: 100%;
    padding: 1.5rem 1rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .header-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .nav-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* Control de visibilidad según el dispositivo */
  .mobile-menu {
    display: block;
  }

  .desktop-navigation {
    display: none;
  }

  @media (min-width: 768px) {
    .mobile-menu {
      display: none;
    }
    
    .desktop-navigation {
      display: block;
    }
  }

  :global(html.dark) .site-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Forzar el color de los enlaces de navegación en modo oscuro */
  :global(html.dark) :global(.nav-links a),
  :global(html.dark) nav a {
    color: #f3f4f6 !important;
  }

  :global(html.dark) :global(.nav-links a:hover),
  :global(html.dark) nav a:hover {
    color: #ff9776 !important;
  }
</style>