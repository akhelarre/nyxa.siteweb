---
const { title, url, description, pubDate, image, collection } = Astro.props;
const formattedDate = pubDate ? new Date(pubDate).toISOString().split('T')[0] : '';

const collectionLabels: Record<string, string> = {
  cinema_studies: 'CINEMA_STUDIES',
  essays: 'ESSAYS',
  literature: 'LITERATURE'
};
const collectionLabel = collection ? (collectionLabels[collection] || String(collection).toUpperCase()) : '';
---

<li class="post-card" data-collection={collection || 'all'}>
  <div class="post-info">
    <div class="post-meta-row">
      {formattedDate && <span class="post-meta">{formattedDate}</span>}
      {collection && (
        <a class="collection-pill" href={`/${collection}/`}>
          [{collectionLabel}]
        </a>
      )}
    </div>
    <h3><a href={url}>{title}</a></h3>
    {description && <p class="post-desc">{description}</p>}
  </div>
  {image?.url && (
    <div class="post-thumb">
      <img src={image.url} alt={image.alt || title} loading="lazy" />
    </div>
  )}
</li>

<style>
  .post-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.75rem;
    padding: 1.5rem 1.75rem;
    margin-bottom: 1.15rem;
    border: 1px solid var(--border-line);
    background: var(--bg-reading);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.22);
    transition: border-color 0.15s ease;
  }

  .post-card:hover {
    border-color: var(--accent);
  }

  .post-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .post-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .post-meta {
    font-size: 0.76rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .collection-pill {
    font-size: 0.72rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--border-line);
    color: var(--fg-primary);
    background: rgba(255, 255, 255, 0.04);
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .collection-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .post-card h3 {
    font-size: 1.25rem;
    margin: 0;
    line-height: 1.35;
  }

  .post-card h3 a {
    color: var(--fg-primary);
    text-decoration: none;
  }

  .post-card h3 a:hover {
    color: var(--accent);
  }

  .post-desc {
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0;
    color: var(--fg-muted);
  }

  .post-thumb img {
    width: 140px;
    height: 90px;
    object-fit: cover;
    border: 1px solid var(--border-line);
  }

  @media (max-width: 600px) {
    .post-card {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
    .post-thumb, .post-thumb img {
      width: 100%;
      height: 160px;
    }
  }
</style>
