<div id="main-menu" class="nav-links">
    <a href="/">Home</a>
    <a href="/about/">About</a>
    <a href="/blog/">Blog</a>
    <a href="/tags/">Tags</a>
</div>

<style>
  .nav-links {
    width: 100%;
    display: none;
    margin: 0;
  }

  .nav-links a {
    display: block;
    text-align: center;
    padding: 10px 0;
    text-decoration: none;
    font-size: 2rem;
    font-weight: bold;
    text-transform: uppercase;
    color: #30008a;
  }

  .nav-links a:hover,
  .nav-links a:focus {
    background-color: #deee85;
  }

  /* Estado expandido en móvil por el script */
  .nav-links.expanded {
    display: flex;
    flex-direction: column;
  }

  /* Escritorio */
  @media screen and (min-width: 636px) {
    .nav-links {
      margin-left: 5em;
      display: block;
      position: static;
      width: auto;
      background: none;
    }

    .nav-links a {
      display: inline-block;
      padding: 15px 24px;
      font-size: 2rem;
    }
  }
</style>