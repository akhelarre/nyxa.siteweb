---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const pageTitle = "About Me";

const identity = {
    firstName: "Nyxa",
    country: "Lemuria",
    occupation: "Virtual Designer",
    hobbies: ["gaming","cinema","web"],
};

const skills = ["HTML", "CSS", "JavaScript", "Astro"]

const happy = true;
const finished = false;
const goal = 3;

const skillColor = "crimson";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
        <style>
            .skill {
                color: var(--skillColor);
                font-weight: bold;
            }
        </style>
	</head>
	<body>
    <Header />
		<h1>{pageTitle}</h1>
        <p> algunas cosas sobre mi:</p>
		<ul>
            <li> Mi nombres es {identity.firstName}</li>
		    <li> Vivo en {identity.country}  y trabajo como {identity.occupation}</li>
              {identity.hobbies.length >= 2 &&
            <li>Two of my hobbies are: {identity.hobbies[0]} and {identity.hobbies[1]}</li>
            }
        </ul>
        <p> Mis skills son: </p>
        <ul>
            {skills.map((skill) => <li class="skill">{skill}</li>)}
        </ul>
        {happy && <p>I am happy to be learning Astro!</p>}

{finished && <p>I finished this tutorial!</p>}

{goal === 3 ? <p>My goal is to finish in 3 days.</p> : <p>My goal is not 3 days.</p>}
	
    <Footer />
    <script>
        import "../scripts/menu.js";
    </script>
    </body>
</html>
