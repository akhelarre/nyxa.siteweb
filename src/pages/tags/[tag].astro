---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPost from '../../components/BlogPost.astro';
import { getAllArchiveEntries } from '../../utils/archive';

export async function getStaticPaths() {
  const allPosts = await getAllArchiveEntries();
  const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post) => (post.data.tags || []).includes(tag));
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout pageTitle={`TAG // #${tag}`}>
  <header class="tag-header">
    <h1>NODO: #{tag}</h1>
    <p>Archivos indexados bajo la etiqueta <strong>{tag}</strong> ({posts.length}) — <a href="/tags/">[VER TODOS LOS TAGS]</a></p>
  </header>

  <ul class="tag-post-list">
    {posts.map((post) => (
      <BlogPost
        url={post.url}
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        image={post.data.image}
        collection={post.collectionName}
      />
    ))}
  </ul>
</BaseLayout>

<style>
  .tag-header {
    margin-bottom: 1.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border-line);
    background: var(--bg-reading);
  }

  .tag-header h1 {
    margin-top: 0;
  }

  .tag-post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
