---
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = Object.values(import.meta.glob('../posts/*.md', { eager: true }));
const tags = [...new Set(allPosts.flatMap((post: any) => post.frontmatter.tags || []))].sort();
const pageTitle = "TAGS // INDEX";
---

<BaseLayout pageTitle={pageTitle}>
  <h1>ÍNDICE DE ETIQUETAS</h1>
  <p>Nodos semánticos y clasificación de archivos del sistema.</p>

  <div class="tags-matrix">
    {tags.map((tag) => {
      const count = allPosts.filter((post: any) => (post.frontmatter.tags || []).includes(tag)).length;
      return (
        <a class="tag-cell" href={`/tags/${tag}`}>
          <span class="tag-name">#{tag}</span>
          <span class="tag-count">[{count}]</span>
        </a>
      );
    })}
  </div>
</BaseLayout>

<style>
  .tags-matrix {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .tag-cell {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-line);
    background: rgba(255, 255, 255, 0.03);
    color: var(--fg-primary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }

  .tag-cell:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(255, 255, 255, 0.07);
  }

  .tag-count {
    font-size: 0.75rem;
    color: var(--accent);
  }
</style>